{
  "name": "skillbridge-ai",
  "version": "1.0.0",
  "description": "SkillBridge AI — Intelligent Career Development Platform Monorepo",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "cd backend && pytest --cov=app",
    "test:frontend": "npm test --prefix frontend",
    "test:all": "npm run test:backend && npm run test:frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "career-development",
    "rag",
    "ai-interview",
    "skill-gap-analysis",
    "software-engineering"
  ],
  "author": "SkillBridge AI Team",
  "license": "MIT"
}
