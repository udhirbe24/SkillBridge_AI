# ==========================================
# SkillBridge AI — Environment Configuration
# ==========================================

# System Environment
NODE_ENV=development
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-skillbridge-ai-2026-secure-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillbridge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@localhost:5432/skillbridge_db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=skillbridge_vectors

# In-Memory Cache & Lock (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin_secret_2026
MINIO_BUCKET_NAME=skillbridge-uploads

# AI & LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Evaluation & Monitoring
RAGAS_EVAL_ENABLED=true
LOG_LEVEL=INFO
